# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string
DATABASE_URI=postgres://oliven:CHANGE_ME@localhost:5432/oliven

# Long random string (32+ chars). Generate with: openssl rand -hex 32
PAYLOAD_SECRET=CHANGE_ME

# Public site URL, no trailing slash (used for canonical links, sitemap, emails)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Outgoing email (quotation notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
EMAIL_FROM="óliven <no-reply@example.com>"
QUOTE_NOTIFY_TO=sales@example.com

# Cloudflare Turnstile (spam protection on the quotation form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=CHANGE_ME
TURNSTILE_SECRET_KEY=CHANGE_ME
